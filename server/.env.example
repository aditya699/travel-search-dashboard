# Copy to server/.env and fill in. Every line is optional.

# --- Cleaning layer (the LLM) -------------------------------------------------
# fake = offline rules, no key, no cost. anthropic = Claude cleans the scraped listings.
LLM_PROVIDER=fake
# Your key from https://platform.claude.com (falls back to the ANTHROPIC_API_KEY env var).
ANTHROPIC_API_KEY=
# Model for cleaning. Opus is the most accurate; claude-haiku-5-5 costs about 40x less
# and is often good enough for this kind of extraction. Run `eval` to compare the two.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Listings sent to Claude per request, and requests in flight at once.
CLEAN_BATCH_SIZE=20
MAX_CONCURRENCY=4

# --- Scraping layer -----------------------------------------------------------
# demo = the three fictional sites built into this repo (no network).
# live = real HTTP to the sites in app/config/sites.json. Read each site's terms first.
SCRAPE_MODE=demo
SCRAPE_USER_AGENT=travel-search-dashboard/0.1 (+https://github.com/aditya699/travel-search-dashboard)
# Minimum seconds between two requests to the same host (robots.txt can ask for more).
SCRAPE_MIN_DELAY_SECONDS=2.0

# --- Storage ------------------------------------------------------------------
# Raw lake, cleaning cache, DuckDB warehouse and Power BI exports all live here.
DATA_DIR=data

# --- API (web preview) --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Power BI publishing (only for `python -m app.cli publish`) ---------------
# Workspace id: the GUID in the workspace URL, app.powerbi.com/groups/<id>/...
PBI_WORKSPACE_ID=
# device = sign in as yourself in the browser (easiest).
# service_principal = an Entra app with a client secret (CI / unattended runs).
PBI_AUTH=device
PBI_TENANT_ID=organizations
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
# The .pbix you saved from Power BI Desktop, and the name it gets in the workspace.
PBI_PBIX_PATH=../powerbi/TravelSearch.pbix
PBI_DATASET_NAME=Travel Search
